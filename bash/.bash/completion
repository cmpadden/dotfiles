#!/usr/bin/env bash

shopt -oq posix && return

# Load completions once, on the first argument-completion Tab. Bash retries
# completion after return 124, so the first Tab works normally too.
__dotfiles_load_completion() {
    complete -r -D
    # shellcheck source=/dev/null
    source "$BREW_PREFIX/etc/profile.d/bash_completion.sh"
    # Load fzf afterward so it can preserve command-specific completions.
    # shellcheck source=/dev/null
    source "$BREW_PREFIX/opt/fzf/shell/completion.bash"
    unset -f __dotfiles_load_completion
    return 124
}

complete -D -F __dotfiles_load_completion -o bashdefault -o default
