{
  "#!": {
    "prefix": "#!",
    "body": [
      "#!/usr/bin/env lua",
      "$1"
    ],
    "description": "#!"
  },
  "local": {
    "prefix": "local",
    "body": [
      "local ${1:x} = ${0:1}"
    ],
    "description": "local"
  },
  "fun": {
    "prefix": "fun",
    "body": [
      "function ${1:fname}(${2:...})",
      "\t$0",
      "end"
    ],
    "description": "fun"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i}=${2:1},${3:10} do",
      "\t${0:print(i)}",
      "end"
    ],
    "description": "for"
  },
  "forp": {
    "prefix": "forp",
    "body": [
      "for ${1:i},${2:v} in pairs(${3:table_name}) do",
      "\t$0",
      "end"
    ],
    "description": "forp"
  },
  "fori": {
    "prefix": "fori",
    "body": [
      "for ${1:i},${2:v} in ipairs(${3:table_name}) do",
      "\t$0",
      "end"
    ],
    "description": "fori"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if $1 then",
      "\t$2",
      "end"
    ],
    "description": "if"
  },
  "ife": {
    "prefix": "ife",
    "body": [
      "if $1 then",
      "\t${2:-- if condition}",
      "else",
      "\t${0:-- else}",
      "end"
    ],
    "description": "ife"
  },
  "elif": {
    "prefix": "elif",
    "body": [
      "elseif $1 then",
      "\t$0"
    ],
    "description": "elif"
  },
  "repeat": {
    "prefix": "repeat",
    "body": [
      "repeat",
      "\t$1",
      "until $0"
    ],
    "description": "repeat"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while $1 do",
      "\t$0",
      "end"
    ],
    "description": "while"
  },
  "wh": {
    "prefix": "wh",
    "body": [
      "while ${1:true} do",
      "\t${0}",
      "end"
    ],
    "description": "wh"
  },
  "wht": {
    "prefix": "wht",
    "body": [
      "while true do",
      "\t${0}",
      "end"
    ],
    "description": "wht"
  },
  "print": {
    "prefix": "print",
    "body": [
      "print(\"${1:string}\")"
    ],
    "description": "print"
  },
  "pr": {
    "prefix": "pr",
    "body": [
      "print($0)"
    ],
    "description": "pr"
  },
  "prs": {
    "prefix": "prs",
    "body": [
      "print(\"$0\")"
    ],
    "description": "prs"
  },
  "prf": {
    "prefix": "prf",
    "body": [
      "print(string.format(\"${1:%s}\"$0))"
    ],
    "description": "prf"
  },
  "wr": {
    "prefix": "wr",
    "body": [
      "io.write($0)"
    ],
    "description": "wr"
  },
  "wrs": {
    "prefix": "wrs",
    "body": [
      "io.write(\"$0\")"
    ],
    "description": "wrs"
  },
  "wrf": {
    "prefix": "wrf",
    "body": [
      "io.write(string.format(\"${1:%s}\"$0))"
    ],
    "description": "wrf"
  },
  "fwr": {
    "prefix": "fwr",
    "body": [
      "io.${1:stderr}:write($0)"
    ],
    "description": "fwr"
  },
  "fwrs": {
    "prefix": "fwrs",
    "body": [
      "io.${1:stderr}:write(\"$0\")"
    ],
    "description": "fwrs"
  },
  "fwrf": {
    "prefix": "fwrf",
    "body": [
      "io.${1:stderr}:write(string.format(\"${2:%s}\"$0))"
    ],
    "description": "fwrf"
  },
  "im": {
    "prefix": "im",
    "body": [
      "import \"${1:import file}\""
    ],
    "description": "im"
  }
}
