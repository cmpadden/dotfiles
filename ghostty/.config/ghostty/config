# Full default configuration with documentation:
#
#     ghostty +show-config --default --docs
#
# List themes:
#
#     ghostty +list-themes
#
# List fonts:
#
#     ghostty +list-fonts
#

theme = light:Catppuccin Latte,dark:Dracula+

# macOS: `brew install --cask font-iosevka`
font-family = "Iosevka Extended"
font-size = 12
window-padding-x = 12
window-padding-y = 12

confirm-close-surface = false
link-url = true
mouse-hide-while-typing = true
resize-overlay = never
shell-integration = none
window-save-state = never

keybind = clear
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super++=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+0=reset_font_size
keybind = super+comma=open_config
keybind = super+shift+comma=reload_config
keybind = super+q=quit
keybind = super+enter=toggle_fullscreen

macos-icon = xray
macos-titlebar-style = hidden
macos-window-shadow = false
